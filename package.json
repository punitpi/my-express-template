{
  "name": "my-express-template",
  "version": "0.0.0",
  "description": "An opinionated Express API starter with JWT auth, Prisma/SQLite, and Swagger docs",
  "private": true,
  "type": "module",
  "author": "Puneeth Prakash",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build-dev": "npm install",
    "build-prod": "npm ci --omit=dev",
    "dev": "node --watch server.js",
    "start": "NODE_ENV=production node server.js",
    "lint": "standard src test server.js",
    "lint-fix": "standard src test server.js --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "standard": "^17.1.2",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
